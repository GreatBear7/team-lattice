      "description": "Distinct target and control evidence; text preserves meaning.",
      "html": "<div class=\"ds-states\"><span class=\"ds-badge ds-badge-warning\">Above target</span><span class=\"ds-badge ds-badge-danger\">Daily signal</span><span class=\"ds-badge ds-badge-quiet\">No daily signal</span></div>",
      "css": ".ds-states{display:flex;flex-wrap:wrap;gap:6px}.ds-badge{font-family:-apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;font-size:13px;font-variant-numeric:tabular-nums;display:inline-flex;align-items:center;white-space:nowrap;font-size:12px;font-weight:550;line-height:16px;padding:3px 6px;border-radius:4px}.ds-badge-danger{background:#fff1ee;color:#b1392e}.ds-badge-warning{background:#fff8e9;color:#80570d}.ds-badge-quiet{background:#f0f5f3;color:#32645c}"
    },
    {
      "name": "Instrument Panel",
      "kind": "card",
      "refersTo": "panel",
      "description": "Flat container for a chart, evidence table or methods.",
      "html": "<section class=\"ds-panel\"><header class=\"ds-panel-title\"><h2>Where is the delay?</h2><span>Medians \u00b7 min</span></header><p class=\"ds-panel-note\">Stage medians are separate measures; they do not add to median response.</p></section>",
      "css": ".ds-panel{font-family:-apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;font-size:13px;font-variant-numeric:tabular-nums;background:var(--surface,#fff);color:var(--ink,#223440);border:1px solid var(--line,#dce3e7);border-radius:12px;overflow:hidden}.ds-panel-title{padding:10px 12px 8px;display:flex;align-items:center;justify-content:space-between;gap:12px}.ds-panel-title h2{margin:0;font-size:14px;line-height:18px;letter-spacing:-.015em;font-weight:650}.ds-panel-title span{font-size:11px;line-height:15px;color:var(--muted,#5b6c78)}.ds-panel-note{margin:0;padding:6px 14px 9px;color:var(--muted,#5b6c78);font-size:11px;line-height:16px}"
    },
    {
      "name": "Selected Zone Table Row",
      "kind": "custom",
      "refersTo": "zone-row-selected",
      "description": "Selected table row with a keyboard-accessible identity-cell button. Preview values are illustrative.",
      "html": "<table class=\"ds-zone-table\"><thead><tr><th>Zone</th><th>Late</th><th>P90</th><th>Signal</th></tr></thead><tbody><tr class=\"ds-zone-selected\"><td><button class=\"ds-zone-select\" aria-pressed=\"true\" aria-label=\"Inspect zone C, Residential\"><span class=\"ds-zone-label\"><span class=\"ds-zone-letter\">C</span><span>Residential</span></span></button></td><td class=\"ds-numeric ds-target\">16.4%</td><td class=\"ds-numeric\">14.2</td><td class=\"ds-signal\">4 days</td></tr></tbody></table>",
      "css": ".ds-zone-table{font-family:-apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;font-size:13px;font-variant-numeric:tabular-nums;width:100%;border-collapse:collapse;text-align:left;color:var(--ink,#223440)}.ds-zone-table th{padding:5px 8px;border-bottom:1px solid var(--line,#dce3e7);background:#f8fafb;color:var(--muted,#5b6c78);font-size:12px;font-weight:550}.ds-zone-table td{height:42px;padding:4px 8px;font-size:12px}.ds-zone-selected{background:#eaf5f3;box-shadow:inset 0 0 0 1px #a2cec7}.ds-zone-select{font-family:-apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;font-size:13px;font-variant-numeric:tabular-nums;display:block;width:100%;min-height:28px;padding:0;border:0;border-radius:3px;background:none;color:inherit;text-align:left;cursor:pointer}.ds-zone-select:focus-visible{outline:2px solid var(--focus,#1267ae);outline-offset:3px}.ds-zone-label{display:flex;align-items:center;gap:7px;font-size:12px;font-weight:550}.ds-zone-letter{width:24px;height:26px;display:grid;place-items:center;flex-shrink:0;border-radius:5px;border:1px solid var(--teal,#087d77);background:var(--teal,#087d77);color:white;font-size:13px;font-weight:700}.ds-numeric{text-align:right;font-weight:600}.ds-target{color:var(--amber,#94610f)}.ds-signal{color:#b1392e;font-weight:550}"
    },
    {
      "name": "Chart Inspection Tooltip",
      "kind": "custom",
      "refersTo": "chart-tooltip",
      "description": "Floating values shown while inspecting daily evidence.",
      "html": "<div class=\"ds-tooltip\" role=\"status\"><strong>Oct 1 \u00b7 monitoring</strong><span>Late rate 16.0% \u00b7 16 / 100 calls</span><span>UCL 15.7% \u00b7 LCL 0.3%</span><span>Upper-limit signal</span></div>",
      "css": ".ds-tooltip{font-family:-apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;font-size:13px;display:flex;flex-direction:column;gap:4px;background:#183247;color:#edf5fc;border-radius:6px;padding:10px 12px;font-size:12px;line-height:1.4;box-shadow:0 5px 14px #18324724;max-width:280px}.ds-tooltip strong{font-weight:650;color:white}@media(prefers-reduced-motion:reduce){.ds-tooltip{animation:none!important}}"
    }
  ],
  "narrative": {
    "northStar": "The Quality Engineer's Instrument Bench",
    "overview": "A light professional workbench for interpreting response quality. Cool off-white ground, white instrument panels and navy ink create a calm, compact operational surface. Teal marks selection and purposeful controls; chart colors identify evidence and its statistical meaning.\n\nThe interface uses aligned figures, persistent panel locations and restrained borders so repeated comparisons remain easy to scan. English labels stay factual. Density serves the supervisor task; it does not justify shrinking the main evidence or hiding unavailable results.",
    "keyCharacteristics": [
      "Cool ground and white instrument panels.",
      "Compact controls with aligned, tabular figures.",
      "Teal selection and explicit statistical color roles.",
      "Data-drawn SVG charts with keyboard inspection."
    ],
    "rules": [
      {
        "name": "Meaning Before Color",
        "body": "Pair a signal color with a label, line style or marker shape. Target failure and a control-limit signal remain distinct.",
        "section": "colors"
      },
      {
        "name": "Tabular Evidence",
        "body": "Use tabular numerals in metrics, tables and plots so comparisons stay vertically aligned.",
        "section": "typography"
      },
      {
        "name": "Flat Instruments",
        "body": "Resting panels use a seam border. Reserve the floating shadow for the chart inspection tooltip; selection uses an inset outline.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the existing semantic colors and distinguish interface colors from chart-series colors.",
      "Do keep textual state labels and keyboard-visible focus on interactive evidence.",
      "Do align comparable numbers and preserve units, unavailable states and chart explanations.",
      "Do let panels reflow and the page scroll on narrow screens."
    ],
    "donts": [
      "Don't turn amber target warnings into red control-limit signals.",
      "Don't show unavailable evidence as zero or as a reassuring normal state.",
      "Don't add decorative imagery or shadows to the data instrument panels.",
      "Don't replace real chart data with decorative sparklines or infer a cause from stage durations."
    ]
  }
}
